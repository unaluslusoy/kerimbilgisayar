{
  "name": "react-example",
  "private": true,
  "version": "1.1.2",
  "type": "module",
  "scripts": {
    "doctor": "node scripts/doctor.mjs",
    "kill-ports": "kill-port 3000 5173 24678 || exit 0",
    "predev": "npm run kill-ports",
    "dev": "tsx server.ts",
    "dev:api": "tsx server.ts",
    "dev:web": "vite",
    "dev:split": "concurrently -k -n API,WEB -c blue,magenta \"npm:dev:api\" \"wait-on http://127.0.0.1:3000/api/ping && npm:dev:web\"",
    "build": "vite build && mkdir -p uploads dist/uploads && (cp -a uploads/. dist/uploads/ 2>/dev/null || true) && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.5",
    "dompurify": "^3.2.4",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "googleapis": "^173.0.0",
    "helmet": "^8.0.0",
    "i18next": "^26.3.4",
    "i18next-browser-languagedetector": "^8.2.1",
    "i18next-http-backend": "^4.0.0",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^0.546.0",
    "multer": "^2.2.0",
    "mysql2": "^3.22.5",
    "nodemailer": "^9.0.1",
    "papaparse": "^5.5.4",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-is": "^19.2.7",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^17.0.8",
    "react-markdown": "^10.1.0",
    "react-quill-new": "^3.8.3",
    "react-router-dom": "^7.18.0",
    "recharts": "^3.8.1",
    "sharp": "^0.35.2",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^2.1.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^8.0.1",
    "@types/papaparse": "^5.5.2",
    "autoprefixer": "^10.4.21",
    "drizzle-kit": "^0.31.10",
    "concurrently": "^9.0.1",
    "esbuild": "^0.25.0",
    "kill-port": "^2.0.1",
    "wait-on": "^8.0.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
