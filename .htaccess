RewriteEngine On

# Ana sayfa istegini de Node.js uygulamasina gönder; DirectoryIndex statik index'i atlamasin
RewriteRule ^$ http://127.0.0.1:3000/ [P,L]

# 1. Medya ve build assetleri dogrudan dist altindaki gercek dosyalardan servis et
RewriteRule ^uploads/(.*)$ /dist/uploads/$1 [L,NC]
RewriteRule ^assets/(.*)$ /dist/assets/$1 [L,NC]

<IfModule mod_headers.c>
	<FilesMatch "\.(svg|png|jpe?g|webp|gif|ico)$">
		Header set Cache-Control "no-cache, must-revalidate"
	</FilesMatch>
</IfModule>

# 2. Eğer gelen istek bir API isteğiyse (/api), arka plandaki Node.js sunucusuna gönder
RewriteRule ^api/(.*)$ http://127.0.0.1:3000/api/$1 [P,L]

# 3. Eğer istek zaten "/dist/" klasörüne yönlenmişse statik build dosyalarini ver
RewriteCond %{REQUEST_URI} ^/dist/
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^dist/ - [L]

# 4. Gelen normal site ziyaretlerini Node.js uygulamasina gönder; Google dogrulama ve analitik etiketleri ham HTML'e burada eklenir
RewriteRule ^(.*)$ http://127.0.0.1:3000/$1 [P,L]
